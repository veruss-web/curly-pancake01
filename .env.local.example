# --- Required: Project URL and Publishable key of the SAME Supabase project ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# --- Optional: store profile printed on receipts (placeholders are used when empty) ---
NEXT_PUBLIC_STORE_NAME=Warung Mie
NEXT_PUBLIC_STORE_ADDRESS=Jl. Contoh No. 1, Kota Anda
NEXT_PUBLIC_STORE_PHONE=
NEXT_PUBLIC_STORE_FOOTER=Terima kasih atas kunjungan Anda. Selamat menikmati!

# --- Optional: public URL of the deployment (used for page metadata) ---
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Optional: make `next build` fail on TypeScript errors (CI sets this) ---
# STRICT_BUILD=1
